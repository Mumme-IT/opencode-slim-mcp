{
  "name": "opencode-slim-mcp",
  "version": "1.0.0",
  "description": "OpenCode V2 plugin — expose native MCP tools through a CLI and on-demand skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mumme-IT/opencode-slim-mcp.git"
  },
  "homepage": "https://github.com/Mumme-IT/opencode-slim-mcp#readme",
  "bugs": {
    "url": "https://github.com/Mumme-IT/opencode-slim-mcp/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "mcp",
    "skills"
  ],
  "license": "MIT",
  "author": "Mumme-IT",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/types/server/index.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "import": "./dist/server.js"
    },
    "./rpc": {
      "types": "./dist/types/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "bin": {
    "slim-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "index.ts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke && npm run test:integration",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "bun test test/integration --timeout 120000",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.23"
  },
  "devDependencies": {
    "@opencode/cli": "2.0.23",
    "@opencode/plugin": "2.0.23",
    "@types/bun": "1.4.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@opencode/client": "2.0.23",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
