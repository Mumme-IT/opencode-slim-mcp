{
  "name": "opencode-slim-mcp",
  "version": "0.1.4",
  "description": "OpenCode plugin — convert MCP servers with slim:true into skills + native proxy tools with connection pooling",
  "keywords": ["opencode", "plugin", "mcp", "skills"],
  "license": "MIT",
  "author": "Mumme-IT",
  "type": "module",
  "main": ".opencode/plugins/slim-mcp.js",
  "exports": {
    ".": {
      "import": "./.opencode/plugins/slim-mcp.js"
    }
  },
  "bin": {
    "slim-mcp-generate": "./generate.js"
  },
  "files": [
    ".opencode",
    "generate.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir .opencode/plugins --target node --entry-naming \"slim-mcp.[ext]\" --external @opencode-ai/plugin --external @opencode-ai/sdk --external @modelcontextprotocol/sdk",
    "prepublishOnly": "bun run build",
    "generate": "node generate.js",
    "refresh": "node generate.js"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.6",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
