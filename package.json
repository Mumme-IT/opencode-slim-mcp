{
  "name": "opencode-slim-mcp",
  "version": "0.4.0",
  "description": "OpenCode plugin — convert MCP servers with slim:true into skills + native proxy tools with connection pooling",
  "keywords": [
    "opencode",
    "plugin",
    "mcp",
    "skills"
  ],
  "license": "MIT",
  "author": "Mumme-IT",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "import": "./dist/server.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "bin": {
    "slim-mcp-generate": "./generate.js"
  },
  "files": [
    "dist",
    "generate.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:server && bun run build:tui",
    "build:server": "bun build index.ts --outdir dist --target node --entry-naming \"server.[ext]\" --external @opencode-ai/plugin --external @opencode-ai/sdk --external @modelcontextprotocol/sdk",
    "build:tui": "NODE_ENV=production bun build tui.tsx --outdir dist --target node --entry-naming \"tui.[ext]\" --external @opencode-ai/plugin --external @opentui/core --external @opentui/solid --external solid-js",
    "postbuild": "mkdir -p .opencode/plugins && cp dist/server.js .opencode/plugins/slim-mcp.js",
    "prepublishOnly": "bun run build",
    "generate": "node generate.js",
    "refresh": "node generate.js"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "@opentui/core": ">=0.2.6",
    "@opentui/solid": ">=0.2.6",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.6",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
